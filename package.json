{
  "name": "codex-mikrotik-mcp",
  "version": "0.1.0",
  "description": "MCP server for connecting Codex CLI to MikroTik RouterOS 6 and 7",
  "author": "emmeril",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmeril/codex-mikrotik.git"
  },
  "homepage": "https://github.com/emmeril/codex-mikrotik#readme",
  "bugs": {
    "url": "https://github.com/emmeril/codex-mikrotik/issues"
  },
  "keywords": [
    "codex",
    "mcp",
    "mikrotik",
    "routeros"
  ],
  "type": "module",
  "bin": {
    "codex-mikrotik-mcp": "dist/server.js",
    "codex-mikrotik-telegram": "dist/telegram.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "dev:telegram": "tsx src/telegram.ts",
    "start": "node dist/server.js",
    "start:telegram": "node dist/telegram.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --only mikrotik-telegram --env production",
    "pm2:restart": "pm2 restart mikrotik-telegram --update-env",
    "pm2:logs": "pm2 logs mikrotik-telegram",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
