# Alamat router yang dapat dijangkau dari mesin Codex CLI
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USERNAME=codex
MIKROTIK_PASSWORD=ganti-dengan-password-kuat

# API biasa: false/8728. API SSL: true/8729.
MIKROTIK_TLS=false
# MIKROTIK_PORT=8728

# Tetap true untuk sertifikat CA publik atau CA internal yang dipercaya.
MIKROTIK_TLS_REJECT_UNAUTHORIZED=true
# MIKROTIK_TLS_CA_FILE=/absolute/path/router-ca.pem
# MIKROTIK_TLS_SERVER_NAME=router.example.net

MIKROTIK_CONNECT_TIMEOUT_MS=8000
MIKROTIK_COMMAND_TIMEOUT_MS=15000
MIKROTIK_MAX_ROWS=2000

# Pengaman; jangan aktifkan kecuali memang diperlukan.
MIKROTIK_WRITE_ENABLED=false
MIKROTIK_SENSITIVE_READ_ENABLED=false

# Agent Telegram. Buat bot melalui @BotFather, lalu isi tokennya.
TELEGRAM_BOT_TOKEN=123456789:ganti-dengan-token-botfather
# Dapatkan ID dengan mengirim /whoami ke bot. Pisahkan beberapa ID dengan koma.
TELEGRAM_ALLOWED_USER_IDS=123456789
# true membatasi bot ke direct message, bukan group.
TELEGRAM_PRIVATE_ONLY=true
TELEGRAM_POLL_TIMEOUT_SECONDS=30
# Preview perubahan kedaluwarsa setelah waktu ini.
TELEGRAM_CONFIRM_TTL_SECONDS=300

# Codex CLI memakai login ChatGPT yang sudah tersimpan. API key OpenAI tidak diperlukan.
# CODEX_BIN=/absolute/path/ke/codex
# app-server mempertahankan satu proses Codex; exec tersedia sebagai fallback.
CODEX_TRANSPORT=app-server
# CODEX_MODEL=gpt-6.1-sol
# CODEX_REASONING_EFFORT=low
# CODEX_SERVICE_TIER=fast
CODEX_TIMEOUT_SECONDS=300
